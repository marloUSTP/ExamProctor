# Copy the settings you need into .env.local and your hosting environment.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-only credentials. Either provider can work alone; both enable backup.
# GEMINI_API_KEY=your-google-ai-studio-key
# GROQ_API_KEY=your-groq-key

# Try Gemini first, then Groq if Gemini is unavailable.
AI_PRIMARY_PROVIDER=gemini
AI_PROVIDER_FALLBACK=true

# auto discovers a current compatible text model. Explicit model IDs are optional.
GEMINI_GRADING_MODEL=auto
GROQ_GRADING_MODEL=auto
